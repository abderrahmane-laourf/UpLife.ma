# ========================================
# UpLife Backend - Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# ────────────────────────────────────────
# Database Configuration
# ────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/uplife_db"

# ────────────────────────────────────────
# JWT Configuration
# ────────────────────────────────────────
# Secret key for JWT tokens (MUST be strong!)
# Generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-generate-with-openssl-rand-base64-64"
JWT_EXPIRATION="7d"

# ────────────────────────────────────────
# Redis Configuration
# ────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
# Full Redis URL (alternative to above)
# REDIS_URL="redis://localhost:6379"

# ────────────────────────────────────────
# WhatsApp / Evolution API Configuration
# ────────────────────────────────────────
# Evolution API base URL
EVOLUTION_API_URL="http://localhost:8080"

# Evolution API key (get from Evolution API dashboard)
EVOLUTION_API_KEY="your-evolution-api-key"

# Evolution API instance name
EVOLUTION_INSTANCE_NAME="uplife-instance"

# ────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ────────────────────────────────────────
# CORS Configuration
# ────────────────────────────────────────
# Allowed origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ────────────────────────────────────────
# OTP Configuration
# ────────────────────────────────────────
OTP_EXPIRATION_MINUTES=5
OTP_LENGTH=6

# ────────────────────────────────────────
# File Upload (Optional)
# ────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# ────────────────────────────────────────
# Logging (Optional)
# ────────────────────────────────────────
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# ────────────────────────────────────────
# NOTES:
# ────────────────────────────────────────
# 1. Replace all placeholder values with your actual credentials
# 2. NEVER commit the .env file to version control
# 3. Keep your JWT_SECRET strong and secret
# 4. Use different secrets for development and production
# 5. Regularly rotate your secrets
