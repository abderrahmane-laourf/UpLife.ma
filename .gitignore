# ========================================
# UpLife.ma - Root .gitignore
# ========================================

# ────────────────────────────────────────
# Environment Variables & Secrets
# ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
*.env
**/.env
**/.env.*

# ────────────────────────────────────────
# Node.js
# ────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ────────────────────────────────────────
# Build Output
# ────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
*.local

# ────────────────────────────────────────
# Database
# ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
prisma/*.db
backend/prisma/*.db
backend/prisma/dev.db*

# ────────────────────────────────────────
# Logs
# ────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
combined.log
error.log
access.log

# ────────────────────────────────────────
# OS Files
# ────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.directory

# ────────────────────────────────────────
# IDE / Editor
# ────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ────────────────────────────────────────
# Testing
# ────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.jest/

# ────────────────────────────────────────
# Temporary Files
# ────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.backup
.temp/

# ────────────────────────────────────────
# Security & Sensitive Data
# ────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
config/secrets.json
secrets/
credentials/
*.credentials

# ────────────────────────────────────────
# Docker
# ────────────────────────────────────────
docker-compose.override.yml
.dockerignore

# ────────────────────────────────────────
# Cloud & Deployment
# ────────────────────────────────────────
.vercel
.netlify
.terraform/
*.tfstate
*.tfstate.*

# ────────────────────────────────────────
# Specific to this project
# ────────────────────────────────────────
# Backend
backend/.env
backend/.env.*
backend/node_modules/
backend/dist/
backend/uploads/
backend/logs/

# Frontend
frontend/.env
frontend/.env.*
frontend/node_modules/
frontend/dist/
frontend/build/

# Evolution API
evolution-api/.env
evolution-api/.env.*
evolution-api/node_modules/
evolution-api/instances/
evolution-api/store/

# Redis data
redis-data/

# Database backups
*.sql.gz
*.dump
backups/

# User uploaded files
uploads/
public/uploads/
static/uploads/

# ────────────────────────────────────────
# WhatsApp/Evolution API Sensitive Data
# ────────────────────────────────────────
evolution-api/instances/
evolution-api/store/
*.data.json
*-auth-info-baileys/
*.session
*.qr

# ────────────────────────────────────────
# NEVER COMMIT THESE!
# ────────────────────────────────────────
# JWT Secrets
JWT_SECRET=*
SECRET_KEY=*
PRIVATE_KEY=*

# Database URLs
DATABASE_URL=*
DB_URL=*
MONGODB_URI=*

# API Keys
API_KEY=*
*_API_KEY=*
WHATSAPP_*=*
OPENAI_*=*
STRIPE_*=*

# Tokens
*_TOKEN=*
ACCESS_TOKEN=*
REFRESH_TOKEN=*
